# cloudflare(하루 무료 한도 있음) 또는 openai(유료)
LLM_PROVIDER=cloudflare
LLM_MODEL=@cf/google/gemma-4-26b-a4b-it
LLM_TIMEOUT_SECONDS=300

# LLM_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# LLM_PROVIDER=openai
OPENAI_API_KEY=

# 호출할 때 Authorization: Bearer 헤더로 보내야 하는 값(32자 이상). 비워 두면 분석 API가 503으로 막힌다
# 만들기: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# 브라우저에서 호출을 허용할 사이트. 로컬 프론트 개발 중이면 그 주소도 넣는다
CORS_ORIGINS=["https://lovedna.bomraylab.com"]
# IP 하나가 하루(UTC 기준)에 분석할 수 있는 횟수
DAILY_LIMIT_PER_IP=10
